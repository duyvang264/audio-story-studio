    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst path = String(body.path || '');\nif (!/^[\\w\\/.\\- ]{1,300}\\.(md|txt)$/.test(path) || path.includes('..')) throw new Error('invalid story path');\nreturn [{ json: { path } }];"
      },
      "id": "9962cea2-9174-575c-aa04-d48db4020ba3",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ASS_API_URL }}/api/stories/import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ASS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ path: $json.path }) }}"
      },
      "id": "a86d6e6f-3746-541f-b587-125a12a9ddd3",
      "name": "Import story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -80
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "431ceb5a-6452-5a5f-bf18-2bfa3f0065dd",
              "leftValue": "={{ $json.rights_status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3756aa77-d938-5ca4-9f48-29b63e9ce8ed",
      "name": "Rights pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ASS_API_URL }}/api/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ASS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '📚 Truyện #' + $json.story_id + ' cần xác nhận bản quyền: /approve rights ' + $json.story_id }) }}"
      },
      "id": "0ab21c0f-40d3-5481-a5af-c0789be88c9e",
      "name": "Ask rights approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -160
      ],
      "onError": "continueErrorOutput",
