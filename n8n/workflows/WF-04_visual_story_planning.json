        "method": "POST",
        "url": "={{ $env.ASS_API_URL }}/api/episodes/{{ $json.episode_id }}/stages/visual_plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ASS_API_KEY }}"
            }
          ]
        },
        "options": {
