# Copy to .env and fill in. Never commit .env.

# --- Core ---
DATABASE_URL=postgresql:///audio_story_studio
STORAGE_DIR=storage
# Shared secret between n8n and the worker API (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
API_KEY=
API_HOST=127.0.0.1
API_PORT=8765

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot
TELEGRAM_ALLOWED_USER_IDS=
# n8n_webhook: n8n Telegram Trigger forwards updates to the API (recommended, needs HTTPS)
# polling: worker long-polls Telegram directly (no public URL needed)
# disabled: no Telegram I/O
TELEGRAM_MODE=polling
# true = write outgoing messages to storage/logs/telegram_outbox.jsonl instead of sending
TELEGRAM_DRY_RUN=false
TELEGRAM_NOTIFY_CHAT_ID=

# --- Providers ---
# macos_say (giọng Linh) | piper (neural, vi_VN-vais1000; tải: python -m piper.download_voices vi_VN-vais1000-medium)
TTS_PROVIDER=piper
TTS_VOICE=Linh
TTS_RATE=170
PIPER_MODEL=storage/models/piper/vi_VN-vais1000-medium.onnx
# percent of the model's natural speed (100 = default, 90 = slower)
PIPER_SPEED=95
# burn (in picture) | soft (mov_text track) | both
SUBTITLE_MODE=both
# mock | codex | local
IMAGE_PROVIDER=mock
# Set true only after `python -m studio.cli check-codex-imagegen` succeeded on this machine
CODEX_IMAGEGEN_VERIFIED=false
CODEX_TIMEOUT_SEC=600
CODEX_MAX_IMAGES_PER_DAY=8
# LocalImageProvider: optional HTTP endpoint (e.g. a local ComfyUI/Draw Things bridge)
LOCAL_IMAGE_ENDPOINT=

# --- Budget guardrails ---
MONTHLY_BUDGET_VND=500000
IMAGE_BUDGET_VND=200000
TTS_BUDGET_VND=200000
RESERVE_BUDGET_VND=100000
MAX_NEW_IMAGES_PER_EPISODE=4
# Separate allowance for images the operator explicitly requests via /regen_scene
MAX_REGEN_IMAGES_PER_EPISODE=2
TARGET_SCENE_DURATION_SEC=120
MIN_SCENE_DURATION_SEC=45
MAX_SCENE_DURATION_SEC=150
ALLOW_PAID_API=false
REQUIRE_APPROVAL_FOR_PAID_GENERATION=true
ALLOW_AUTO_PUBLISH=false

# --- Pipeline ---
AUTO_CHAIN=true
N8N_EVENT_WEBHOOK_URL=
# generate with: python -m studio.cli make-bgm   (empty = no BGM)
BGM_PATH=storage/assets/bgm/dark_ambient.m4a
BGM_VOLUME=0.10

# TikTok / Shorts 9:16 (đoạn cao trào, render sau khi bản YouTube qua QC)
TIKTOK_ENABLED=true
TIKTOK_HEIGHT=1920
TIKTOK_MIN_SEC=60
TIKTOK_MAX_SEC=120
TIKTOK_TARGET_SEC=90
TIKTOK_LUFS=-14

# Tự đăng sau khi duyệt (mặc định TẮT). Chỉ chạy khi bạn bấm "Duyệt xuất bản" trên Telegram.
# YouTube: tạo OAuth client "Desktop app" (Google Cloud, bật YouTube Data API v3), tải JSON về đường dẫn dưới,
#          rồi chạy: .venv/bin/python -m studio.cli youtube-auth
# TikTok:  app trên developers.tiktok.com với Login Kit + Content Posting API (scope video.upload),
#          rồi chạy: .venv/bin/python -m studio.cli tiktok-auth  (video vào hộp nháp, bạn tự bấm đăng trong app)
PUBLISH_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_SECRETS=storage/secrets/youtube_client_secret.json
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=24
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Google Drive: Desktop OAuth JSON (or auto-detect one client_secret_*.json in storage/secrets)
GOOGLE_DRIVE_CLIENT_SECRETS=storage/secrets/google_drive_client_secret.json

# Horror audio engine (local/offline; these are editorial targets)
AUDIO__TARGET_LUFS=-16
AUDIO__LOUDNESS_TOLERANCE_LU=1
AUDIO__MAX_TRUE_PEAK_DBTP=-1.5
AUDIO__CODEC_HEADROOM_DB=0.75
AUDIO__TARGET_LRA_LU=7
AUDIO__AAC_BITRATE=256k
AUDIO__MAX_AUTO_REPAIR_ATTEMPTS=2
AUDIO__CONDITIONAL_DENOISE=false
AUDIO__CONDITIONAL_DEESS=false
AUDIO__CONDITIONAL_COMPRESSION=false
AUDIO__REQUIRE_LISTENING_REVIEW=true
AUDIO__PROCEDURAL_FALLBACK=true
AUDIO__DUCK_MIN_DB=8
AUDIO__DUCK_MAX_DB=14
STORY_ENGINE__TARGET_DURATION_SEC=1200
# Optional offline TTS: TTS_PROVIDER=vieneu, VIENEU_VOICE=Thiện Minh
# See docs/AUDIO_ENGINE.md for isolated Python 3.12/model setup and all settings.
